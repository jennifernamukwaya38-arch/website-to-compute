<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Namukwaya Janefer</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
:root{--brand:#FFD700;}
html{scroll-behavior:smooth;}
body{font-family:Inter,sans-serif;margin:0;padding:0;background:white;color:black;}
a{transition:0.2s;text-decoration:none;}
a:hover{text-decoration:underline;}
header{position:sticky;top:0;z-index:40;background:black;color:white;padding:1rem;display:flex;justify-content:space-between;align-items:center;}
header nav a{margin-left:1rem;color:white;}
header nav a:hover{color:var(--brand);}
section{padding:2rem;opacity:0;transform:translateY(30px);transition:all 0.8s ease;}
section.visible{opacity:1;transform:translateY(0);}
footer{padding:1.5rem;border-top:1px solid black;text-align:center;}
.product-grid{display:flex;overflow-x:auto;gap:1rem;margin-top:1rem;padding-bottom:1rem;scroll-snap-type:x mandatory;}
.product-card{flex:0 0 250px;border:1px solid #000;padding:1rem;border-radius:1rem;scroll-snap-align:start;background:white;transition:transform 0.3s;}
.product-card:hover{transform:scale(1.05);}
.product-card img{width:100%;height:150px;object-fit:cover;border-radius:.5rem;margin-bottom:.5rem;}
.product-card::-webkit-scrollbar{height:6px;}
.product-card::-webkit-scrollbar-thumb{background:#ccc;border-radius:3px;}
#backToTop{position:fixed;bottom:20px;right:20px;background:var(--brand);color:black;padding:0.5rem 0.75rem;border-radius:999px;cursor:pointer;display:none;z-index:50;transition:0.3s;}
#backToTop:hover{transform:scale(1.1);}
</style>
</head>
<body>

<header>
  <a href="#home" class="font-bold text-lg">Namukwaya Janefer</a>
  <nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#services">Services</a>
    <a href="#shop">Shop</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section id="home" class="text-center">
  <h1 class="text-4xl font-bold">Hi, I’m Namukwaya Janefer</h1>
  <p class="mt-4 text-lg">Organised, reliable and creative</p>
  <div class="mt-6 space-x-4">
    <a href="#shop" class="px-4 py-2 bg-yellow-500 text-black rounded-lg">Shop Digital Products</a>
    <a href="#contact" class="px-4 py-2 border border-black rounded-lg">Contact Me</a>
  </div>
</section>

<section id="about" class="max-w-3xl mx-auto">
  <h2 class="text-3xl font-bold">About Me</h2>
  <p class="mt-4">I’m Namukwaya Janefer, a freelancer who is organised, reliable, and creative. I specialise in digital products design and graphics design.</p>
</section>

<section id="services" class="max-w-3xl mx-auto">
  <h2 class="text-3xl font-bold">Services</h2>
  <ul class="mt-4 list-disc list-inside space-y-2">
    <li>Graphicsdesigner</li>
    <li>Digital Products design</li>
  </ul>
</section>

<section id="shop" class="max-w-5xl mx-auto">
  <h2 class="text-3xl font-bold text-center">Digital Products</h2>
  <div class="product-grid" id="productGrid"></div>
  <p class="mt-4 text-center text-sm text-neutral-600">Checkout via WhatsApp</p>
</section>

<section id="contact" class="max-w-3xl mx-auto text-center">
  <h2 class="text-3xl font-bold">Contact</h2>
  <p class="mt-4">Send me a message via WhatsApp:</p>
  <a href="https://wa.me/256764042469" target="_blank" class="mt-4 inline-block px-4 py-2 bg-yellow-500 text-black rounded-lg">WhatsApp Me</a>
</section>

<footer>
  <p>© <span id="year"></span> Namukwaya Janefer. All rights reserved.</p>
</footer>

<div id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'});">↑ Top</div>

<script>
const PRODUCTS=[
  {title:"Social Media Content Calendar",price:9.99,description:"30-day calendar with hooks, captions & post ideas.",image:"https://images.unsplash.com/photo-1558655146-d09347e92766?q=80&w=1200&auto=format&fit=crop"},
  {title:"E-commerce VA SOP Pack",price:14.00,description:"SOPs for orders, support, returns & KPIs (Notion).",image:"https://images.unsplash.com/photo-1557827983-0120d6a65c2e?q=80&w=1200&auto=format&fit=crop"},
  {title:"Podcast VA Starter Kit",price:12.00,description:"Outreach scripts, episode planner, checklist & handoff.",image:"https://images.unsplash.com/photo-1516280440614-37939bbacd81?q=80&w=1200&auto=format&fit=crop"}
];

function fmtUSD(x){return '$'+x.toFixed(2);}
function renderProducts(){
  const grid=document.getElementById('productGrid');if(!grid) return;
  grid.innerHTML='';
  PRODUCTS.forEach(p=>{
    const card=document.createElement('div');card.className='product-card';
    card.innerHTML=`
      <img src="${p.image}">
      <h3 class="font-bold mt-2">${p.title}</h3>
      <p>${p.description}</p>
      <p class="font-bold mt-1">${fmtUSD(p.price)}</p>
      <a href="https://wa.me/256764042469?text=Hi%2C%20I%20want%20to%20buy%20${encodeURIComponent(p.title)}" 
      target="_blank" class="mt-2 inline-block px-3 py-1 bg-yellow-500 text-black rounded-lg">Buy via WhatsApp</a>
    `;
    grid.appendChild(card);
  });
}

function revealSections(){
  document.querySelectorAll('section').forEach(sec=>{
    const rect=sec.getBoundingClientRect();
    if(rect.top<window.innerHeight-100){
      sec.classList.add('visible');
    }
  });
}

document.addEventListener('DOMContentLoaded',()=>{
  renderProducts();
  document.getElementById('year').textContent=new Date().getFullYear();
  revealSections();
  window.addEventListener('scroll',()=>{
    revealSections();
    const btn=document.getElementById('backToTop');
    btn.style.display = window.scrollY>300 ? 'block' : 'none';
  });
});
</script>

</body>
</html>
